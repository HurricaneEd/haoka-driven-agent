# ===== 复制本文件为 .env，填入真实 Key 后使用 =====
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env

# ── LLM（DeepSeek，保持原配置）────────────────────────
DEEPSEEK_API_KEY=sk-deepseek-placeholder
OPENAI_API_BASE=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash

# ── Embeddings（硅基流动 SiliconFlow，OpenAI 兼容接口）────────
# 注册/获取 Key：https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=sk-siliconflow-placeholder
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
# embedding_api_key 留空时自动回退用 SILICONFLOW_API_KEY
#EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ── 数据库 / 向量库 ──────────────────────────────────
DATABASE_URL=sqlite:///./customer_support.db
CHROMA_DB_PATH=./chroma_db
# 知识库初始化时是否种演示数据（生产置 false）
SEED_DEMO_DATA=false

# ── 应用 ─────────────────────────────────────────────
DEBUG=true
HOST=0.0.0.0
PORT=8000
